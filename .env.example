# EmailJS credentials — copy this file to .env and fill in your values.
# Sign up at https://www.emailjs.com/ (free tier works fine).
#
# 1. Add a service (connect your Gmail account).
# 2. Create an email template. In the template body use variables like:
#      From: {{from_name}} <{{from_email}}>
#      Message: New subscriber!  Name: {{from_name}}  Email: {{from_email}}
# 3. Copy the Service ID, Template ID, and Public Key below.

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Optional: override the default recipient (defaults to henryscomicshop@gmail.com)
VITE_RECIPIENT_EMAIL=henryscomicshop@gmail.com

# --- Google AdSense (optional overrides) ---------------------------
# Publisher ID. Defaults to the historical client ca-pub-6482725806427470
# if unset. Public value — also lives in public/ads.txt.
# VITE_ADSENSE_CLIENT_ID=ca-pub-6482725806427470
#
# Manual ad-unit slot IDs. Create these in the AdSense dashboard
# (Ads → By ad unit → Display ads) for the comic, about, and FAQ pages.
# If unset, the corresponding AdSlot renders nothing — useful while the
# site is under review and before the slots have been created.
# VITE_ADSENSE_SLOT_COMIC=1234567890
# VITE_ADSENSE_SLOT_ABOUT=1234567890
# VITE_ADSENSE_SLOT_FAQ=1234567890

# --- Google Analytics (optional override) --------------------------
# Defaults to the historical G-LGF133CWHQ measurement ID if unset.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
